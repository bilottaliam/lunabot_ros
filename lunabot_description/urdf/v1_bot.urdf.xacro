<?xml version="1.0"?>
<robot name="v1_bot"
  xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="use_sim" default="true" />

  <xacro:if value="$(arg use_sim)">
    <xacro:property name="camera_sim_link_offset" value="-0.01" />
    <xacro:property name="lidar_sim_link_offset" value="0.01" />
  </xacro:if>
  <xacro:unless value="$(arg use_sim)">
    <xacro:property name="camera_sim_link_offset" value="0" />
    <xacro:property name="lidar_sim_link_offset" value="0" />
  </xacro:unless>

  <material name="camera_grey">
    <color rgba="0.81 0.81 0.81 1.0" />
  </material>

  <material name="black">
    <color rgba="0.22 0.22 0.22 1.0" />
  </material>

  <!-- ================================= -->
  <!--            BODY LINKS             -->
  <!-- ================================= -->

  <link name="base_link">
    <visual>
      <geometry>
        <mesh
          filename="file:///$(find lunabot_description)/meshes/v1_bot/v1_bot_body.dae" />
      </geometry>
      <origin xyz="0 0 0.1625" rpy="0 0 1.5708" />
    </visual>
    <collision>
      <geometry>
        <mesh
          filename="file:///$(find lunabot_description)/meshes/v1_bot/v1_bot_body.stl" />
      </geometry>
      <origin xyz="0 0 0.1625" rpy="0 0 1.5708" />
    </collision>
    <inertial>
      <mass value="25.0" />
      <origin xyz="0 0 0.1625" />
      <inertia ixx="1.3669" ixy="0.0" ixz="0.0" iyy="3.3602" iyz="0.0" izz="4.7271" />
    </inertial>
  </link>

  <!-- ================================= -->
  <!--           SENSOR LINKS            -->
  <!-- ================================= -->

  <link name="camera_front_link">
    <visual>
      <geometry>
        <mesh
          filename="file:///$(find lunabot_description)/meshes/v1_bot/v1_bot_d456_camera.stl" />
      </geometry>
      <origin xyz="0 ${camera_sim_link_offset} 0" rpy="0 0 0" />
      <material name="camera_grey" />
    </visual>
    <collision>
      <geometry>
        <mesh
          filename="file:///$(find lunabot_description)/meshes/v1_bot/v1_bot_d456_camera.stl" />
      </geometry>
      <origin xyz="0 ${camera_sim_link_offset} 0" rpy="0 0 0" />
    </collision>
  </link>

  <link name="camera_front_optical_link"></link>

  <link name="camera_back_link">
    <visual>
      <geometry>
        <mesh
          filename="file:///$(find lunabot_description)/meshes/v1_bot/v1_bot_d456_camera.stl" />
      </geometry>
      <origin xyz="0 ${camera_sim_link_offset} 0" rpy="0 0 0" />
      <material name="camera_grey" />
    </visual>
    <collision>
      <geometry>
        <mesh
          filename="file:///$(find lunabot_description)/meshes/v1_bot/v1_bot_d456_camera.stl" />
      </geometry>
      <origin xyz="0 ${camera_sim_link_offset} 0" rpy="0 0 0" />
    </collision>
  </link>

  <link name="camera_back_optical_link"></link>

  <link name="camera_fisheye_mount_link">
    <inertial>
      <mass value="0.05" />
      <origin xyz="0 0 0" />
      <inertia ixx="0.00001" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.00001" />
    </inertial>
  </link>

  <link name="camera_fisheye_yaw_link">
    <inertial>
      <mass value="0.05" />
      <origin xyz="0.035 0 0" rpy="0 0 1.5708" />
      <inertia ixx="0.00001" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.00001" />
    </inertial>
    <visual>
      <geometry>
        <mesh
          filename="file:///$(find lunabot_description)/meshes/v1_bot/v1_bot_fisheye_mount.dae" />
      </geometry>
      <origin xyz="0.035 0 0" rpy="0 0 1.5708" />
      <material name="camera_grey" />
    </visual>
    <collision>
      <geometry>
        <mesh
          filename="file:///$(find lunabot_description)/meshes/v1_bot/v1_bot_fisheye_mount.stl" />
      </geometry>
    </collision>
  </link>

  <link name="camera_fisheye_link">
    <inertial>
      <mass value="0.1" />
      <origin xyz="0 0 0" />
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001" />
    </inertial>
    <visual>
      <geometry>
        <mesh
          filename="file:///$(find lunabot_description)/meshes/v1_bot/v1_bot_fisheye_camera.stl" />
      </geometry>
      <material name="camera_grey" />
    </visual>
    <collision>
      <geometry>
        <mesh
          filename="file:///$(find lunabot_description)/meshes/v1_bot/v1_bot_fisheye_camera.stl" />
      </geometry>
    </collision>
  </link>

  <link name="camera_fisheye_optical_link"></link>

  <link name="livox_frame">
    <visual>
      <geometry>
        <mesh
          filename="file:///$(find lunabot_description)/meshes/v1_bot/v1_bot_mid360_lidar.dae" />
      </geometry>
      <origin xyz="${lidar_sim_link_offset} 0 0" rpy="0 0 0" />
      <material name="camera_grey" />
    </visual>
    <collision>
      <geometry>
        <mesh
          filename="file:///$(find lunabot_description)/meshes/v1_bot/v1_bot_mid360_lidar.stl" />
      </geometry>
      <origin xyz="${lidar_sim_link_offset} 0 0" rpy="0 0 0" />
    </collision>
  </link>

  <link name="mid360_imu_link"></link>

  <!-- ================================= -->
  <!--            WHEEL LINKS            -->
  <!-- ================================= -->

  <link name="front_right_wheel_link">
    <inertial>
      <mass value="2.27" />
      <origin xyz="0 0 0" />
      <inertia ixx="0.0255" ixy="0.0" ixz="0.0" iyy="0.0255" iyz="0.0" izz="0.0510" />
    </inertial>
    <collision>
      <geometry>xacro
        <cylinder length="0.127" radius="0.1016" />
      </geometry>
      <origin xyz="0 0 0" rpy="1.5708 0 0" />
    </collision>
  </link>

  <link name="front_left_wheel_link">
    <inertial>
      <mass value="2.27" />
      <origin xyz="0 0 0" />
      <inertia ixx="0.0255" ixy="0.0" ixz="0.0" iyy="0.0255" iyz="0.0" izz="0.0510" />
    </inertial>
    <collision>
      <geometry>
        <cylinder length="0.127" radius="0.1016" />
      </geometry>
      <origin xyz="0 0 0" rpy="-1.5708 0 0" />
    </collision>
  </link>

  <link name="rear_right_wheel_link">
    <inertial>
      <mass value="2.27" />
      <origin xyz="0 0 0" />
      <inertia ixx="0.0255" ixy="0.0" ixz="0.0" iyy="0.0255" iyz="0.0" izz="0.0510" />
    </inertial>
    <collision>
      <geometry>
        <cylinder length="0.127" radius="0.1016" />
      </geometry>
      <origin xyz="0 0 0" rpy="1.5708 0 0" />
    </collision>
  </link>

  <link name="rear_left_wheel_link">
    <inertial>
      <mass value="2.27" />
      <origin xyz="0 0 0" />
      <inertia ixx="0.0255" ixy="0.0" ixz="0.0" iyy="0.0255" iyz="0.0" izz="0.0510" />
    </inertial>
    <collision>
      <geometry>
        <cylinder length="0.127" radius="0.1016" />
      </geometry>
      <origin xyz="0 0 0" rpy="-1.5708 0 0" />
    </collision>
  </link>

  <!-- ================================= -->
  <!--           SENSOR JOINTS           -->
  <!-- ================================= -->

  <joint name="base_camera_front_joint" type="fixed">
    <parent link="base_link" />
    <child link="camera_front_link" />
    <origin xyz="0.526 0 0.584" rpy="0 0.785398 0" />
  </joint>

  <joint name="camera_front_optical_joint" type="fixed">
    <parent link="camera_front_link" />
    <child link="camera_front_optical_link" />
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708" />
  </joint>

  <joint name="base_camera_back_joint" type="fixed">
    <parent link="base_link" />
    <child link="camera_back_link" />
    <origin xyz="-0.277 0 0.602" rpy="0 0.785398 3.14" />
  </joint>

  <joint name="camera_back_optical_joint" type="fixed">
    <parent link="camera_back_link" />
    <child link="camera_back_optical_link" />
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708" />
  </joint>

  <joint name="base_camera_fisheye_mount_joint" type="fixed">
    <parent link="base_link" />
    <child link="camera_fisheye_mount_link" />
    <origin xyz="-0.2 0 0.635" rpy="0 0 0" />
  </joint>

  <joint name="camera_fisheye_yaw_joint" type="revolute">
    <parent link="camera_fisheye_mount_link" />
    <child link="camera_fisheye_yaw_link" />
    <origin xyz="-0.035 0 0" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit effort="10" velocity="1.0" lower="-3.14159" upper="3.14159" />
    <dynamics damping="0.1" friction="0.1" />
  </joint>

  <joint name="camera_fisheye_pitch_joint" type="fixed">
    <parent link="camera_fisheye_yaw_link" />
    <child link="camera_fisheye_link" />
    <origin xyz="0.077 0 -0.006" rpy="0 0.785398 0" />
  </joint>

  <joint name="camera_fisheye_optical_joint" type="fixed">
    <parent link="camera_fisheye_link" />
    <child link="camera_fisheye_optical_link" />
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708" />
  </joint>

  <joint name="base_mid360_joint" type="fixed">
    <parent link="base_link" />
    <child link="livox_frame" />
    <origin xyz="-0.23 0 0.59" rpy="3.14159 0 1.5708" />
  </joint>

  <joint name="mid360_imu_joint" type="fixed">
    <parent link="base_link" />
    <child link="mid360_imu_link" />
    <origin xyz="-0.23 0 0.59" rpy="3.14159 0 1.5708" />
  </joint>

  <!-- ================================= -->
  <!--            WHEEL JOINTS           -->
  <!-- ================================= -->

  <joint name="base_rear_right_wheel_joint" type="continuous">
    <parent link="base_link" />
    <child link="rear_right_wheel_link" />
    <origin xyz="-0.235 -0.25 0.08" rpy="0 0 0" />
    <axis xyz="0 1 0" />
  </joint>

  <joint name="base_rear_left_wheel_joint" type="continuous">
    <parent link="base_link" />
    <child link="rear_left_wheel_link" />
    <origin xyz="-0.235 0.25 0.08" rpy="0 0 0" />
    <axis xyz="0 1 0" />
  </joint>

  <joint name="base_front_right_wheel_joint" type="continuous">
    <parent link="base_link" />
    <child link="front_right_wheel_link" />
    <origin xyz="0.215 -0.25 0.08" rpy="0 0 0" />
    <axis xyz="0 1 0" />
  </joint>

  <joint name="base_front_left_wheel_joint" type="continuous">
    <parent link="base_link" />
    <child link="front_left_wheel_link" />
    <origin xyz="0.215 0.25 0.08" rpy="0 0 0" />
    <axis xyz="0 1 0" />
  </joint>


  <!-- ================================= -->
  <!--       GAZEBO CONFIGURATION        -->
  <!-- ================================= -->

  <xacro:if value="$(arg use_sim)">
    <gazebo reference="base_link">
    </gazebo>

    <gazebo reference="camera_fisheye_yaw_link">
    </gazebo>

    <gazebo reference="front_right_wheel_link">
      <!-- URDF <gazebo> extension tags; ODE slip1/slip2 has no gz-sim equivalent -->
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
      <kp>1000000</kp>
      <kd>500</kd>
    </gazebo>

    <gazebo reference="front_left_wheel_link">
      <!-- URDF <gazebo> extension tags; ODE slip1/slip2 has no gz-sim equivalent -->
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
      <kp>1000000</kp>
      <kd>500</kd>
    </gazebo>

    <gazebo reference="rear_right_wheel_link">
      <!-- URDF <gazebo> extension tags; ODE slip1/slip2 has no gz-sim equivalent -->
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
      <kp>1000000</kp>
      <kd>500</kd>
    </gazebo>

    <gazebo reference="rear_left_wheel_link">
      <!-- URDF <gazebo> extension tags; ODE slip1/slip2 has no gz-sim equivalent -->
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
      <kp>1000000</kp>
      <kd>500</kd>
    </gazebo>

    <gazebo reference="camera_front_link">
      <sensor type="rgbd_camera" name="camera_front">
        <pose>0 0 0 0 0 0</pose>
        <update_rate>60.0</update_rate>
        <visualize>false</visualize>
        <camera>
          <horizontal_fov>1.540</horizontal_fov>
          <image>
            <width>640</width>
            <height>360</height>
            <format>R8G8B8</format>
          </image>
          <distortion>
            <k1>-0.06792929080519726</k1>
            <k2>0.08058277259698843</k2>
            <k3>-0.04417756393089296</k3>
            <p1>-0.001690544521662593</p1>
            <p2>-0.0008235437909836152</p2>
          </distortion>
          <clip>
            <near>0.05</near>
            <far>10.0</far>
          </clip>
        </camera>
        <topic>camera_front</topic>
        <gz_frame_id>camera_front_optical_link</gz_frame_id>
      </sensor>
    </gazebo>

    <gazebo reference="camera_back_link">
      <sensor type="rgbd_camera" name="camera_back">
        <pose>0 0 0 0 0 0</pose>
        <update_rate>60.0</update_rate>
        <visualize>false</visualize>
        <camera>
          <horizontal_fov>1.540</horizontal_fov>
          <image>
            <width>640</width>
            <height>360</height>
            <format>R8G8B8</format>
          </image>
          <distortion>
            <k1>-0.06792929080519726</k1>
            <k2>0.08058277259698843</k2>
            <k3>-0.04417756393089296</k3>
            <p1>-0.001690544521662593</p1>
            <p2>-0.0008235437909836152</p2>
          </distortion>
          <clip>
            <near>0.05</near>
            <far>10.0</far>
          </clip>
        </camera>
        <topic>camera_back</topic>
        <gz_frame_id>camera_back_optical_link</gz_frame_id>
      </sensor>
    </gazebo>

    <gazebo reference="camera_fisheye_link">
      <sensor type="rgbd_camera" name="camera_fisheye">
        <pose>0 0 0 0 0 0</pose>
        <update_rate>60.0</update_rate>
        <visualize>false</visualize>
        <camera>
          <horizontal_fov>2.1</horizontal_fov>
          <image>
            <width>640</width>
            <height>360</height>
            <format>R8G8B8</format>
          </image>
          <distortion>
            <k1>0.0</k1>
            <k2>0.0</k2>
            <k3>0.0</k3>
            <p1>0.0</p1>
            <p2>0.0</p2>
          </distortion>
          <clip>
            <near>0.05</near>
            <far>6.0</far>
          </clip>
        </camera>
        <topic>camera_fisheye</topic>
        <gz_frame_id>camera_fisheye_optical_link</gz_frame_id>
      </sensor>
    </gazebo>

    <gazebo reference="livox_frame">
      <sensor type="gpu_lidar" name="mid360_lidar_sensor">
        <!-- Replaces the Gazebo Classic Livox plugin; lunabot_util/pointcloud_to_livox turns the
             bridged PointCloud2 into the CustomMsg on /livox/lidar that the real driver publishes -->
        <always_on>true</always_on>
        <pose>0 0 0 0 0 0</pose>
        <visualize>false</visualize>
        <update_rate>10</update_rate>
        <topic>livox/lidar_points</topic>
        <gz_frame_id>livox_frame</gz_frame_id>
        <lidar>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.1415926</min_angle>
              <max_angle>3.1241394</max_angle>  <!-- pi - 1 deg, so 360 samples don't repeat a column -->
            </horizontal>
            <vertical>
              <samples>32</samples>
              <resolution>1</resolution>
              <min_angle>-0.126</min_angle>
              <max_angle>0.964</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.1</min>
            <max>50.0</max>
            <resolution>0.002</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </lidar>
      </sensor>
    </gazebo>

    <gazebo reference="mid360_imu_link">
      <gravity>false</gravity>
      <sensor name="imu_sensor" type="imu">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <visualize>true</visualize>
        <topic>livox/imu</topic>
        <gz_frame_id>mid360_imu_link</gz_frame_id>
        <!-- Noiseless like the old sim: the Classic ROS 2 IMU plugin ignored <gaussianNoise>,
             and the LIO *_sim.yaml configs were tuned on that -->
        <pose>0 0 0 0 0 0</pose>
      </sensor>
    </gazebo>

    <gazebo>
      <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(find lunabot_config)/params/gazebo/gazebo_v1_bot_params.yaml</parameters>
      </plugin>
    </gazebo>

    <ros2_control name="GazeboSimSystem" type="system">
      <hardware>
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </hardware>
      <joint name="base_front_right_wheel_joint">
        <command_interface name="velocity">
          <!-- rad/s; Lyrical ros2_control enforces these, GUI teleop peaks near 9.2 -->
          <param name="min">-10</param>
          <param name="max">10</param>
        </command_interface>
        <state_interface name="position" />
        <state_interface name="velocity" />
      </joint>
      <joint name="base_front_left_wheel_joint">
        <command_interface name="velocity">
          <!-- rad/s; Lyrical ros2_control enforces these, GUI teleop peaks near 9.2 -->
          <param name="min">-10</param>
          <param name="max">10</param>
        </command_interface>
        <state_interface name="position" />
        <state_interface name="velocity" />
      </joint>
      <joint name="base_rear_right_wheel_joint">
        <command_interface name="velocity">
          <!-- rad/s; Lyrical ros2_control enforces these, GUI teleop peaks near 9.2 -->
          <param name="min">-10</param>
          <param name="max">10</param>
        </command_interface>
        <state_interface name="position" />
        <state_interface name="velocity" />
      </joint>
      <joint name="base_rear_left_wheel_joint">
        <command_interface name="velocity">
          <!-- rad/s; Lyrical ros2_control enforces these, GUI teleop peaks near 9.2 -->
          <param name="min">-10</param>
          <param name="max">10</param>
        </command_interface>
        <state_interface name="position" />
        <state_interface name="velocity" />
      </joint>
      <joint name="camera_fisheye_yaw_joint">
        <command_interface name="position">
          <param name="min">-3.14159</param>
          <param name="max">3.14159</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity" />
      </joint>
    </ros2_control>
  </xacro:if>
</robot>